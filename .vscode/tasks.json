{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Slipstream: Setup",
      "type": "npm",
      "script": "setup",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Slipstream: Build",
      "type": "npm",
      "script": "build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Slipstream: Validate",
      "type": "npm",
      "script": "validate",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Slipstream: E2E",
      "type": "npm",
      "script": "test:e2e",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
