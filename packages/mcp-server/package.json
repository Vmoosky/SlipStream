{
  "name": "@slipstream/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing Slipstream's compressing tools over stdio.",
  "license": "MIT",
  "bin": {
    "slipstream-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --outputFile.json=../../test-results/coverage/mcp-server/unit.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@slipstream/core": "*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
